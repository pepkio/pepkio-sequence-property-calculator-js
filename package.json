{
  "name": "pepkio-sequence-property-calculator",
  "version": "0.1.1",
  "description": "Call the Pepkio Sequence Property Calculator REST API from Node.js with typed ESM imports and a CLI.",
  "license": "MIT",
  "author": "Pepkio Team",
  "homepage": "https://www.pepkio.com/tools/sequence-property-calculator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-sequence-property-calculator-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-sequence-property-calculator-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "keywords": [
    "sequence",
    "fasta",
    "protein",
    "dna",
    "rna",
    "molecular-weight",
    "isoelectric-point",
    "gc-content",
    "extinction-coefficient",
    "gravy",
    "instability-index",
    "ligation",
    "dilution",
    "concentration",
    "sequence-property-calculator",
    "pepkio",
    "molecular-biology",
    "bioinformatics",
    "life-sciences",
    "typescript",
    "node",
    "rest-api",
    "scientific-computing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-sequence-property-calculator": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run test/client.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "test:all": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "undici": "^7.27.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
